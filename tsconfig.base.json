{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@poe/contracts": ["packages/contracts/src/index.ts"],
      "@poe/ui": ["packages/ui/src/index.ts"]
    }
  }
}
